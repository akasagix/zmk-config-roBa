#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&lt {
    tapping-term-ms = <200>;
};

&trackball {
    automouse-layer = <3>;
    scroll-layers = <4>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        arrow_mo {
            bindings = <&mo 2>;
            key-positions = <18 19>;
        };

        bt_sel_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <40 41 0>;
            layers = <0>;
            timeout-ms = <100>;
        };

        bt_sel_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <40 41 1>;
            layers = <0>;
            timeout-ms = <100>;
        };

        bt_sel_2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <40 41 2>;
            layers = <0>;
            timeout-ms = <100>;
        };

        bt_sel_3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <40 41 3>;
            layers = <0>;
            timeout-ms = <100>;
        };

        bt_sel_4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <40 41 4>;
            layers = <0>;
            timeout-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q             &kp W         &kp E         &kp R                        &kp T                                            &kp Y        &kp U  &lt 4 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F                        &kp G          &kp ESC            &kp BACKSPACE  &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V                        &kp B          &mo 1              &kp MINUS      &kp N        &kp M  &kp COMMA  &kp DOT  &kp SQT
&kp LCTRL         &kp LEFT_WIN  &kp LEFT_ALT  &kp F14                      &kp SPACE      &trans             &kp ENTER      &kp F13                                 &kp SLASH
            >;

            sensor-bindings = <&inc_dec_kp PG_UP PAGE_DOWN>;
        };

        FUNCTION {
            display-name = "Function";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5                            &kp N1     &kp N2     &kp N3            &kp N4             &kp N5
&kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &trans        &kp BACKSLASH  &kp N6     &kp N7     &kp N8            &kp N9             &kp N0
&kp LEFT_SHIFT  &trans  &trans  &trans  &trans   &trans      &kp GRAVE    &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp HOME
&trans  &trans  &trans  &trans  &trans   &trans      &trans       &trans                                                &kp END
            >;
        };

        ARROW {
            display-name = "Arrow";
            bindings = <
&kp ESCAPE      &kp LC(LS(TAB))         &kp UP_ARROW    &kp LC(TAB)              &trans                       &trans  &trans  &trans  &trans  &trans
&kp HOME        &kp LEFT_ARROW          &kp DOWN_ARROW  &kp RIGHT_ARROW          &kp END  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT  &kp LG(LS(LEFT_ARROW))  &trans          &kp LG(LS(RIGHT_ARROW))  &trans   &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans          &trans                  &trans          &trans                   &trans   &trans      &trans  &kp LEFT_WIN                    &trans
            >;

            sensor-bindings = <&inc_dec_kp LC(PAGE_UP) LC(PAGE_DOWN)>;
        };

        MOUSE {
            display-name = "Mouse";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            display-name = "Scroll";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            display-name = "System";
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        extra {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
